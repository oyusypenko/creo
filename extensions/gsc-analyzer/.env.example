# GSC Analyzer extension configuration.
# Copy to .env in your working directory (or export the variables) and fill in.

# Path to the Google service-account JSON key (required for GSC API commands:
# list-sites, inspect, analytics, sitemaps, index-request, seo-audit, ...).
# Page analysis commands work without it.
GSC_KEY_FILE=./service-account-key.json

# Search Console property. Domain property: sc-domain:example.com
# URL-prefix property: https://example.com/  (trailing slash is REQUIRED)
GSC_SITE_URL=sc-domain:example.com

# Default lookback window (days) for analytics/seo-audit commands.
GSC_DEFAULT_DAYS=28

# Optional: PageSpeed Insights API key for Core Web Vitals (cwv) commands.
PAGESPEED_API_KEY=your_pagespeed_api_key

# Directory for gsc_toolkit reports and outputs.
GSC_OUTPUT_DIR=./output

# Directory where gsc_ui_export.mjs saves Page Indexing drilldown CSVs
# (also settable per-run with --out=<dir>).
GSC_EXPORTS_DIR=./gsc-exports

# Persistent Chromium profile for the UI automation scripts (holds the
# manually-established Google session; shared by both .mjs scripts).
GSC_UI_PROFILE_DIR=~/.cache/gsc-ui-profile
